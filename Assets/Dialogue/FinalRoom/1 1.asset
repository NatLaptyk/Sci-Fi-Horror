  sophieOpeningLines:
  - speakerName: Adam
    text: My... occipital lobe?
    audioClip: {fileID: 8300000, guid: fa242f33e40eb48fca6a030d5649685d, type: 3}
    displayDuration: 2
  - speakerName: AI
    text: Yes, it is located in your brain. Just like that scientist, Dr. Jenkins
      tried to do and failed. The procedure is incredibly dangerous and I cannot
      guarantee your safety. You would need to do it on your own while I guide you.
      Otherwise, the visions will increase and you will be trapped here.
    audioClip: {fileID: 8300000, guid: aeac8033d8ef249c192b57b5a39becfd, type: 3}
    displayDuration: 6
  choices:
  - buttonText: Choose the Mood Stabilizer (Requires having over 40 Sanity)
    adamReply:
      speakerName: 
      text: 
      audioClip: {fileID: 0}
      displayDuration: 0
    sophieResponse:
      speakerName: AI
      text: You have chosen the mood stabilizer. It should take a moment to work.
      audioClip: {fileID: 8300000, guid: e6d829d5226964025b3a7e628a5239df, type: 3}
      displayDuration: 3
    nextNode: {fileID: 11400000, guid: 356f4fd6c28154b30bb383f16d4a97ef, type: 2}
  - buttonText: Choose to remove part of your brain
    adamReply:
      speakerName: 
      text: 
      audioClip: {fileID: 0}
      displayDuration: 0
    sophieResponse:
      speakerName: AI
      text: Since you have chosen to remove a part of your occipital lobe, I will
        guide you through the process. Follow my directions when I call them out.
        If you make more than one mistake you will die. When I call out the directions,
        you will only have two seconds to react. Should you fail, you will die. Please
        walk over to the table over there and we will begin.
      audioClip: {fileID: 8300000, guid: 85f1d0b44b9424e25a07c77424335fe8, type: 3}
      displayDuration: 6
    nextNode: {fileID: 11400000, guid: b9aff2967f78243d883a1fd74f8cbd49, type: 2}
