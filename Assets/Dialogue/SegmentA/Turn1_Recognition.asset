  m_Name: Turn1_Recognition
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  sophieOpeningLines:
  - speakerName: Sophie
    text: You look like you've seen a ghost. Are you alright?
    audioClip: {fileID: 8300000, guid: fecafd71c5d8b794aa6ea02cc6530f75, type: 3}
    displayDuration: 3
  choices:
  - buttonText: What are you doing here?
    adamReply:
      speakerName: Adam
      text: What are you doing here?
      audioClip: {fileID: 8300000, guid: de8b53f67de6a1c44baa4e8516ac99f7, type: 3}
      displayDuration: 3
    sophieResponse:
      speakerName: Sophie
      text: What do you mean what am I doing here? I was looking for you.
      audioClip: {fileID: 8300000, guid: 030ec3d1a43446947b695d27e21a71f2, type: 3}
      displayDuration: 3
    nextNode: {fileID: 11400000, guid: 4e5afd88e2ca67d4d81cd0c3374abb98, type: 2}
  - buttonText: I'm fine. Just tired
    adamReply:
      speakerName: Adam
      text: I'm fine. Just tired.
      audioClip: {fileID: 8300000, guid: 16fbf80d4f6f35249821ab22ccd9ee40, type: 3}
      displayDuration: 3
    sophieResponse:
      speakerName: Sophie
      text: You don't look fine. I was looking for you.
      audioClip: {fileID: 8300000, guid: d26a010d091152d469b03414f2dcd488, type: 3}
      displayDuration: 3
    nextNode: {fileID: 11400000, guid: 4e5afd88e2ca67d4d81cd0c3374abb98, type: 2}
  - buttonText: "What\u2026"
    adamReply:
      speakerName: Adam
      text: "What\u2026"
      audioClip: {fileID: 8300000, guid: d3bae4330c114974cae5b4f57a203fbf, type: 3}
      displayDuration: 3
    sophieResponse:
      speakerName: Sophie
      text: I was looking for you. You said you'd come.
      audioClip: {fileID: 8300000, guid: 28e50c2f8e4432045b4468419de0f832, type: 3}
      displayDuration: 3
    nextNode: {fileID: 11400000, guid: 4e5afd88e2ca67d4d81cd0c3374abb98, type: 2}
