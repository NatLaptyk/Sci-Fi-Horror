  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  sophieOpeningLines:
  - speakerName: Adam
    text: Oh, I'm coming to. I'm feeling so much better now.
    audioClip: {fileID: 8300000, guid: 3d7d8d13762424debafdccfc9cf20d82, type: 3}
    displayDuration: 3
  - speakerName: AI
    text: Yes. The lights never turned out. It was all in your mind. I recommend
      you to leave the lab immediately, because the mood stabilizers will only work
      for but a moment.
    audioClip: {fileID: 8300000, guid: 5b1f64de4aa23420fa8eba36773cb4f7, type: 3}
    displayDuration: 3
  - speakerName: Adam
    text: Got it I'll leave right away. Thank you. Thank you so much.
    audioClip: {fileID: 8300000, guid: fc0b615f4c49f4c9c91bef6e8f308a81, type: 3}
    displayDuration: 2
  - speakerName: AI
    text: You are very welcome.
    audioClip: {fileID: 8300000, guid: d05e6c727541a43aa843d3665b5a2393, type: 3}
    displayDuration: 3
