  m_Script: {fileID: 11500000, guid: fd02ae3f5b980f24d8176e342f9aa382, type: 3}
  m_Name: 1 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  sophieOpeningLines:
  - speakerName: AI
    text: You may have noticed you are experiencing strange visions and that you
      can no longer escape the space station. I did try to warn you when you arrived.
    audioClip: {fileID: 8300000, guid: 85af8f54c6f27415a877290f2cfb4267, type: 3}
    displayDuration: 4
  - speakerName: AI
    text: Worry not, because I have a solution for you. Assuming you haven't lost
      too much sanity, you can receive an injection of mood stabilizers to return
      you to normal so that you may leave and the visions may stop. However, if you
      don't have much sanity left, then there's only one other option, to manually
      remove a piece of your occipital lobe, as the former scientist tried to do
      over there
    audioClip: {fileID: 8300000, guid: 50cd7e4779257457eae64b8b0373d8b3, type: 3}
    displayDuration: 6
  - speakerName: Adam
    text: My... occipital lobe?
    audioClip: {fileID: 8300000, guid: fa242f33e40eb48fca6a030d5649685d, type: 3}
    displayDuration: 3
  - speakerName: AI
    text: 'Yes, it is located in your brain. Just like that scientist, Dr. Jenkins
      tried to do and failed. '
    audioClip: {fileID: 8300000, guid: aeac8033d8ef249c192b57b5a39becfd, type: 3}
    displayDuration: 6
  choices: []
  autoAdvanceNode: {fileID: 0}
