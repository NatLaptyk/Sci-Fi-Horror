  m_Script: {fileID: 11500000, guid: 5d5402e25dfb368418a5ea7d85c2a851, type: 3}
  m_Name: BunkBeds_Log
  m_EditorClassIdentifier: Assembly-CSharp::AudioLog
  entryTitle: Personal Log - Dr. Ahern, Mission Day 14
  audioClip: {fileID: 8300000, guid: a150649f8ad01924fab9567e154d112d, type: 3}
  transcript: "I miss you. I just wish we were still together. Lately I have been
    hearing voices. I heard your voice - I still can\u2019t get over how we broke
    up. Do you mind\u2026 calling me? Please.. Send me a message. Anything. I\u2019m
    so scared up here. Things are weird. I just\u2026 need a comforting voice right
    now. Please.\r\n"
