  m_EditorClassIdentifier: Assembly-CSharp::AudioLog
  entryTitle: "Station Log \u2014 Lab Tech, Germaine Savik - Mission Day 15"
  audioClip: {fileID: 8300000, guid: ea0e733286190a2488afe064e4f7e0db, type: 3}
  transcript: "Eureka! I can\u2019t believe it - we are talking to it! We really
