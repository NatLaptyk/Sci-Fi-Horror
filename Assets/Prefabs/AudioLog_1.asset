  m_Script: {fileID: 11500000, guid: 5d5402e25dfb368418a5ea7d85c2a851, type: 3}
  m_Name: AudioLog_1
  m_EditorClassIdentifier: Assembly-CSharp::AudioLog
  entryTitle: "Station Log \u2014 Dr. Reyes, Mission Day 11"
  audioClip: {fileID: 0}
  transcript: "\"The Ocean doesn't attack. It gives. It gives you exactly what you
    cannot bear to see. Kris walked into the lab today and she's been dead for three
    years. She knew things about our last conversation that I never told anyone.
    I ran the tissue scans \u2014 there's no human biology there. Just\u2026 something
    that learned to be her from my grief.\""
