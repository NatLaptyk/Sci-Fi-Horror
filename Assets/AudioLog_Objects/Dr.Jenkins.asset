  m_Script: {fileID: 11500000, guid: 5d5402e25dfb368418a5ea7d85c2a851, type: 3}
  m_Name: Dr.Jenkins
  m_EditorClassIdentifier: Assembly-CSharp::AudioLog
  entryTitle: "Station Log \u2014 Dr. Jenkins, Mission Day 18"
  audioClip: {fileID: 8300000, guid: 6e4ef8267a1737648971f343e473b767, type: 3}
  transcript: "Dr. Jenkins's log. Lab report 221.1\nThe planet has been communicating
    with us. Causing us to see loved ones as a way to connect with us and talk to
    us. It doesn\u2019t mean us any harm, but it doesn\u2019t know that it is causing\u2026
    us to lose our minds. These visitors appear more and more often. Some of us have
    even seen our passed loved ones with our own eyes. Including myself. The planet
    appears that as it communicates with us, it doesn\u2019t know that it is harming
    us.\nWhoever you are, if you are listening to this, you have to get out of here.\n"
